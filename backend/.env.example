# =============================================================================
# CaterConnect Backend — Environment Configuration
# Copy this to .env and fill in your real values.
# =============================================================================

# Application
APP_ENV=development
APP_NAME="CaterConnect"
APP_VERSION="0.1.0"
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# =============================================================================
# Database — Supabase PostgreSQL
#
# 1. Go to https://supabase.com → your project → Settings → Database
# 2. Copy the "Connection string" → URI tab
# 3. Replace [YOUR-PASSWORD] with your DB password
# 4. The URL format:
#    postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
#
# Use the "Transaction" pooler (port 6543) for serverless/web apps.
# Use the "Session" pooler (port 5432) for long-lived connections.
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Supabase project credentials (used for storage and future auth integration)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =============================================================================
# Redis (for rate limiting and caching)
# For local dev, run: docker compose up redis
# For production, use Upstash Redis (https://upstash.com)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
SESSION_EXPIRE_SECONDS=86400
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# OTP
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_REQUESTS=5
OTP_RATE_LIMIT_WINDOW_SECONDS=3600
# Set to true in development to skip real SMS and see OTP in response
OTP_DEV_MODE=true

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Logging
LOG_LEVEL=INFO

# Storage — uses Supabase Storage (configured via SUPABASE_URL above)
STORAGE_BUCKET=caterconnect-assets
