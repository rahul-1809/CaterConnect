# =============================================================================
# CaterConnect Backend — Environment Configuration
# Copy this to .env and fill in your real values.
# =============================================================================

# Application
APP_ENV=development
APP_NAME="CaterConnect"
APP_VERSION="0.1.0"
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://caterconnect:caterconnect@localhost:5432/caterconnect
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
SESSION_EXPIRE_SECONDS=86400
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# OTP
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_REQUESTS=5
OTP_RATE_LIMIT_WINDOW_SECONDS=3600
# Set to true in development to skip real SMS and see OTP in response
OTP_DEV_MODE=true

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Logging
LOG_LEVEL=INFO

# Storage (S3-compatible)
STORAGE_BUCKET=caterconnect-assets
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
